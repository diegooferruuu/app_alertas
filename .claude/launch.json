{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start:dev"
      ],
      "cwd": "apps/backend",
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "apps/mobile",
      "port": 8081,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api",
        "BROWSER": "none"
      }
    },
    {
      "name": "backend-pruebas",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start:dev"
      ],
      "cwd": "apps/backend",
      "port": 3001,
      "url": "http://localhost:3001",
      "env": {
        "DB_NAME": "app_alertas_test",
        "BACKEND_PORT": "3001",
        "PUSH_PASARELA": "simulada"
      }
    }
  ]
}
