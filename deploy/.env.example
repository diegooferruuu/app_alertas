# Plantilla del `.env` del servidor. Se copia a `deploy/.env` EN EL SERVIDOR y se
# completa allí. Ese archivo no se versiona ni sale del servidor.
#
# Los secretos se generan en el servidor, nunca se copian del `.env` de
# desarrollo:   openssl rand -hex 32

DOMINIO=152-67-46-104.sslip.io

DB_USERNAME=alertas
DB_PASSWORD=
DB_NAME=alertas

JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Notificaciones reales. El token lo crea el dueño de la cuenta de Expo.
PUSH_PASARELA=expo
EXPO_ACCESS_TOKEN=

# En la beta, el celular de quien la opera, nunca el 110: un avistamiento de
# prueba no debe llegar a la Policía real.
AUTORIDAD_TELEFONO=
AUTORIDAD_MENSAJERIA=
