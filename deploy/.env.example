# Plantilla del `.env` del servidor. Se copia a `deploy/.env` EN EL SERVIDOR y se
# completa allí. Ese archivo no se versiona ni sale del servidor.
#
# Los secretos se generan en el servidor, nunca se copian del `.env` de
# desarrollo:   openssl rand -hex 32

DOMINIO=alertatemprana.download
# El de los primeros APK, que lo traen compilado. Vaciarlo cuando ningún tester
# use ya esa versión (ver deploy/Caddyfile).
DOMINIO_ANTERIOR=152-67-46-104.sslip.io

DB_USERNAME=alertas
DB_PASSWORD=
DB_NAME=alertas

JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Notificaciones reales. El token lo crea el dueño de la cuenta de Expo.
PUSH_PASARELA=expo
EXPO_ACCESS_TOKEN=

# En la beta, el celular de quien la opera, nunca el 110: un avistamiento de
# prueba no debe llegar a la Policía real.
AUTORIDAD_TELEFONO=
AUTORIDAD_MENSAJERIA=

# Contacto público: el mismo de la ficha de Google Play y de /privacidad. Ahí
# llegan los pedidos de eliminación de cuenta de quien ya no tiene la app.
CORREO_CONTACTO=dferrufinoc@gmail.com

# Aviso por correo de cada reporte de contenido. Opcional: sin esto el reporte
# se guarda igual. Con Gmail: smtp.gmail.com, puerto 465 y una «contraseña de
# aplicación» (myaccount.google.com/apppasswords), nunca la de la cuenta.
SMTP_HOST=
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CONTRASENA=
