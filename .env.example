# Backend
BACKEND_PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app_alertas

# JWT
#
# Secretos que firman las sesiones: vacíos a propósito. Genera cada uno con
#   openssl rand -base64 48
# y que sean distintos entre sí. El servidor no arranca si faltan, si miden
# menos de 32 caracteres o si son los de ejemplo que se publicaron antes en este
# archivo: con un secreto conocido, cualquiera puede fabricar sesiones de otro.
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Mobile
# En dispositivo físico usa la IP de tu Mac en la red local, no localhost:
# el celular resuelve localhost contra sí mismo, no contra tu máquina.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Notificaciones push
# ---------------------------------------------------------------------------

# Qué pasarela se usa: "simulada" (por defecto) o "expo".
#
# La simulada registra el envío y marca las entregas como aceptadas sin salir a
# la red. Es útil para desarrollo y es el valor por defecto a propósito: no
# enviar es recuperable, mandar notificaciones reales a teléfonos de personas
# desde una máquina de desarrollo no lo es.
#
# Cuál está activa se anuncia en el arranque del servidor.
PUSH_PASARELA=simulada

# Credencial de Expo. Solo hace falta si la cuenta tiene activada la seguridad
# reforzada para push (Expo → Account Settings → Access Tokens). Sin ella el
# envío funciona, pero cualquiera que conozca un token podría mandar
# notificaciones en nombre del proyecto.
# EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Reporte de avistamiento
# ---------------------------------------------------------------------------

# A quién llama el botón «Llamar» del reporte. Obligatorio. En producción, 110.
# Fuera de producción el servidor NO arranca si no es un celular de 8 dígitos
# (6… o 7…): ningún reporte de prueba puede llegar a una línea de emergencia.
# Para pruebas y demostraciones, usa tu propio celular.
AUTORIDAD_TELEFONO=

# WhatsApp de la autoridad. Opcional: vacío, la app no muestra «Enviar por
# WhatsApp». Se puede escribir sin código de país; el servidor agrega el 591.
AUTORIDAD_MENSAJERIA=

# ---------------------------------------------------------------------------
# Ciclo de vida de las denuncias
#
# Todas estas variables son opcionales: si se omiten se usan los valores por
# defecto documentados en apps/backend/src/config/denuncias.config.ts, que son
# los que aparecen aquí. Se listan para que sean visibles y ajustables por
# política, sin tocar código.
# ---------------------------------------------------------------------------

# Alcance de difusión, en metros. Deliberadamente corto: ninguna autoridad
# respalda la alerta, solo la declaración jurada de quien la firmó.
RADIO_PROVISIONAL_M=2000
RADIO_TERCERO_NO_FAMILIAR_M=1000

# Vida de la alerta antes de caducar, en horas, y lo que suma cada prolongación.
# Caducar detiene la difusión; no borra el caso, que sigue visible para su autor.
CADUCIDAD_PROVISIONAL_H=24
CADUCIDAD_TERCERO_NO_FAMILIAR_H=12

# Veces que quien presentó una denuncia puede prolongar su alerta. Prolongar la
# mantiene en el mapa y en la lista, sin volver a notificar a nadie.
MAX_PROLONGACIONES=3

# Régimen de faltas. Personas distintas que tienen que declarar falsas las
# denuncias de una cuenta para suspenderla. Cuenta personas y no cierres: una
# sola persona, por muchas veces que cierre, nunca suspende a nadie.
CIERRES_CON_SANCION_PARA_SUSPENSION=2

# Días que una falta deja a la cuenta sin registrar, firmar ni prolongar
# denuncias. La falta queda para siempre; la suspensión temporal, no.
DIAS_SUSPENSION_TEMPORAL=7

# Alertas que una cuenta puede tener difundiéndose a la vez. Es un límite de
# uso, no una sanción.
LIMITE_ALERTAS_PROVISIONALES=2

# Cada cuántos minutos el planificador marca las alertas vencidas.
# No determina cuándo una denuncia deja de difundirse —de eso se encarga el
# filtro por expira_en en cada consulta—, solo cada cuánto se refleja en la
# columna estado.
INTERVALO_CADUCIDAD_MIN=5

# Antigüedad máxima de la ubicación de una persona para alertarla (horas).
# La consulta opera sobre la última posición registrada, no sobre dónde está
# ahora. A quien no reporta posición hace días no tiene sentido alertarlo.
ANTIGUEDAD_MAXIMA_UBICACION_H=72

# Cada cuántos minutos el worker busca emisiones pendientes.
INTERVALO_EMISION_MIN=1

# Reintentos de una emisión fallida antes de darla por perdida.
MAX_INTENTOS_EMISION=3

# Recibos de entrega: si Apple o Google recibieron cada notificación. Expo los
# tiene listos unos minutos después del envío y los guarda 24 horas.
# Cada cuántos minutos se piden, y cuántos minutos se espera tras enviar antes
# de pedirlos (Expo recomienda 15; bajarlo sirve para una demostración).
INTERVALO_RECIBOS_MIN=5
ESPERA_RECIBO_MIN=15
