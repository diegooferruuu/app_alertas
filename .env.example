# Backend
BACKEND_PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app_alertas

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Mobile
# En dispositivo físico usa la IP de tu Mac en la red local, no localhost:
# el celular resuelve localhost contra sí mismo, no contra tu máquina.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Ciclo de vida de las denuncias
#
# Todas estas variables son opcionales: si se omiten se usan los valores por
# defecto documentados en apps/backend/src/config/denuncias.config.ts, que son
# los que aparecen aquí. Se listan para que sean visibles y ajustables por
# política, sin tocar código.
# ---------------------------------------------------------------------------

# Alcance de difusión, en metros. El radio provisional es deliberadamente corto:
# una denuncia recién firmada todavía no tiene respaldo.
RADIO_PROVISIONAL_M=2000
RADIO_CORROBORADO_M=10000
RADIO_TERCERO_NO_FAMILIAR_M=1000

# Vida de la alerta antes de caducar, en horas. Caducar detiene la difusión;
# no borra el caso, que sigue visible para su autor.
CADUCIDAD_PROVISIONAL_H=24
CADUCIDAD_CORROBORADA_H=168
CADUCIDAD_TERCERO_NO_FAMILIAR_H=12

# Firmas de terceros necesarias para corroborar un caso.
CORROBORADORES_NECESARIOS=1

# Moderación: señalizaciones coincidentes para que surta efecto, y puntaje a
# partir del cual se deriva el rol. Una sola señalización nunca decide.
SENALIZACIONES_NECESARIAS=3
UMBRAL_REPUTACION_MODERADOR=500

# Restricción tras la primera desactivación recibida (720 h = 30 días).
# No es permanente a propósito: una desactivación aislada no es verificable.
RESTRICCION_PRIMERA_DESACTIVACION_H=720

# Precisión del geohash de un avistamiento. 6 ≈ 1.2 × 0.6 km.
# Subirlo estrecha la zona y acerca el dato a una ubicación identificable.
PRECISION_GEOHASH=6
