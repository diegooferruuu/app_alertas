{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    // DOM va por la rama web: `storage.ts` usa localStorage cuando
    // `Platform.OS === 'web'`, y hay componentes con variante `.web.tsx`. Sin
    // esto el typecheck salía siempre con cuatro errores fijos, y un gate que
    // está roto de serie deja de servir para detectar los errores de verdad.
    "lib": ["ES2020", "DOM"],
    "jsx": "react-native",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
